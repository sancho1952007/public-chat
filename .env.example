# Cloudflare Account ID
CF_ACC_ID=
# Cloudflare Workers AI API Key
CF_AI_API_KEY=
# Redis URL
REDIS_URL=
# The salt used at the time of IP address hashing
IP_HASH_SECRET= # Can be generated using: openssl rand -hex 32
# Max number of messages retrieved
MAX_MESSAGES=30
# Maximum number of characters in a message
BUN_PUBLIC_MESSAGE_SIZE_LIMIT=400
# Rate limit count
RL_COUNT=30
# Rate limit period in seconds
RL_PERIOD=86400
# Number of bad messages before used is barred from sending messages
BAD_MESSAGES_LIMIT=3
# Amount of time for the ban
BAD_MESSAGES_BAN_PERIOD=86400